# ============================================================
# CourtManager Pro — plantilla de variables de entorno
# Copia a .env.local (local) o pégalas en Vercel → Settings → Environment Variables
# NUNCA subas claves reales a GitHub.
# ============================================================

# --- Supabase (obligatorio en producción) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# URL pública de la app (SEO, WebAuthn, enlaces)
NEXT_PUBLIC_APP_URL=https://courtmanagerpro.vercel.app

# --- Modo ---
# Producción real: no definir DEMO_MODE o dejarlo en false
# NEXT_PUBLIC_DEMO_MODE=false
#
# Demo comercial (datos ficticios multi-club):
# NEXT_PUBLIC_DEMO_MODE=true

# --- Crons Vercel (plantilla, calendario, cumpleaños) ---
# Authorization: Bearer <CRON_SECRET>
# Rutas: /api/roster/sync?trigger=cron
#        /api/calendar/sync?trigger=cron
#        /api/birthdays/send
CRON_SECRET=

# --- IA (OCR inventario + ping proveedores) ---
# Inventario por documento usa Gemini; el resto es opcional (GET /api/ai/ping?secret=)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
MANUS_API_KEY=
FAL_KEY=
AI_PING_SECRET=

# --- Correo cumpleaños REAL (Ramón + Carlos, mismo envío automático) ---
# 1) Cuenta en https://resend.com → API Keys → Create API Key
# 2) Domains → Add domain: ramondelpozorott.es → añade los DNS que pide Resend
# 3) Cuando el dominio esté "Verified":
RESEND_API_KEY=
BIRTHDAY_EMAIL_FROM=CourtManager Pro <noreply@ramondelpozorott.es>
# Destinatarios fijos en código: info@ramondelpozorott.es + charlie-r-k@hotmail.com
#
# Alternativa SMTP (si no usas Resend):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Scripts locales opcionales (no necesarios en Vercel) ---
# CARLOS_PASSWORD=
# SUPERADMIN_PASSWORD=
# TEST_BIOMETRIC_PASSWORD=

# --- Tienda / Calendario / Plantilla ---
# URL tienda: src/config/store.ts → https://shop.realmadrid.com/
# Calendario y plantilla: APIs oficiales realmadrid.com (sin API key)
